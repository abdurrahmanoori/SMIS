<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FluentValidation" />
		<PackageReference Include="FluentValidation.AspNetCore" />
		<PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Newtonsoft.Json" />
		<PackageReference Include="Seq.Extensions.Logging" />
		<PackageReference Include="Serilog" />
		<PackageReference Include="Serilog.Extensions.Hosting" />
		<PackageReference Include="Serilog.Sinks.Console" />
		<PackageReference Include="Serilog.Sinks.Seq" />
		<PackageReference Include="Serilog.Sinks.PeriodicBatching" />
		<PackageReference Include="Swashbuckle.AspNetCore" />
		<!-- MiniProfiler packages -->
		<PackageReference Include="MiniProfiler.AspNetCore" />
		<PackageReference Include="MiniProfiler.EntityFrameworkCore" />
		<PackageReference Include="MiniProfiler.AspNetCore.Mvc" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\SMIS.Application\SMIS.Application.csproj" />
	  <ProjectReference Include="..\SMIS.Infrastructure.Server\SMIS.Infrastructure.Server.csproj" />
	  <!--<ProjectReference Include="..\SMIS.Infrastructure.Server\SMIS.Infrastructure.Server.csproj" />-->
<!--	  <ProjectReference Include="..\SMIS.Infrastructure\SMIS.Infrastructure.Server.csproj" />-->
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="JsonConverters\" />
	</ItemGroup>

	<ItemGroup>
		<!-- Shared configuration — single source of truth across all projects -->
		<Content Include="..\appsettings.shared.json" Link="appsettings.shared.json" CopyToOutputDirectory="PreserveNewest" />
		<!-- Local production secrets are git-ignored but must be present in the
		     publish artifact when this machine performs a production publish. -->
		<Content Update="appsettings.Production.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('appsettings.Production.json')" />
	</ItemGroup>

</Project>
